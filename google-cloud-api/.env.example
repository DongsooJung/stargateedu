PORT=8080
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MAPS_API_KEY=replace-with-server-side-maps-key
CORS_ORIGINS=https://www.stargateedu.co.kr,https://stargateedu.co.kr
RATE_LIMIT_PER_MINUTE=30
# Only expose curated BigQuery views that contain public/non-sensitive columns.
BIGQUERY_PUBLIC_VIEWS=your-gcp-project-id.stargate_public.realtors_view
# Hard query-cost guardrail: 100 MB per request by default.
BIGQUERY_MAX_BYTES_BILLED=100000000
